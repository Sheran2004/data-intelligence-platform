<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Data Intelligence Platform</title>
<link rel="stylesheet" href="/static/css/style.css" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>

<header class="topbar">
  <div class="topbar-inner">
    <div class="brand">
      <div class="logo">⚡</div>
      <div>
        <div class="brand-title">Data Intelligence Platform</div>
        <div class="brand-sub">Prompt → Workflow → Source-backed Dataset</div>
      </div>
    </div>
    <div class="topbar-stats" id="topbar-stats">
      <div class="tstat"><span id="stat-runs">0</span><label>Runs</label></div>
      <div class="tstat"><span id="stat-records">0</span><label>Records</label></div>
      <div class="tstat"><span id="stat-types">0</span><label>Types</label></div>
    </div>
    <div style="display:flex;gap:8px;align-items:center;">
      <button class="topbar-btn" id="btn-watchlist" title="Watchlist (starred records)">★ Watchlist</button>
      <button class="topbar-btn" id="btn-notifications" title="Notifications">🔔 <span id="notif-badge" class="badge" hidden>0</span></button>
      <button class="topbar-btn" id="btn-bulk-export" title="Export everything">📦 Bulk Export</button>
      <button class="theme-toggle" id="theme-toggle" title="Toggle dark/light mode">🌙</button>
    </div>
  </div>
</header>

<main class="layout">
  <aside class="sidebar">
    <button class="new-run-btn" id="btn-new-run">＋ New Collection</button>
    <button class="btn-secondary" id="btn-load-demo" style="width:100%">⚡ Load Demo Data</button>
    <button class="btn-secondary" id="btn-ab-test" style="width:100%;margin-top:6px;">🆎 A/B Test</button>

    <div class="history">
      <div class="section-title" style="display:flex;align-items:center;justify-content:space-between;">
        <span>Recent Runs</span>
        <span style="display:flex;gap:4px;align-items:center;">
          <input id="history-search" placeholder="Filter..." style="padding:4px 8px;font-size:11px;background:var(--bg-3);border:1px solid var(--border-soft);border-radius:6px;color:var(--text);width:90px;" />
          <button class="btn-danger" id="btn-clear-history" title="Delete all runs" style="padding:4px 8px;font-size:11px;">Clear</button>
        </span>
      </div>
      <div class="toolbar-tabs" id="history-tabs">
        <button class="tab active" data-status="all">All</button>
        <button class="tab" data-status="done">Done</button>
        <button class="tab" data-status="running">Running</button>
        <button class="tab" data-status="failed">Failed</button>
      </div>
      <ul class="run-list" id="run-list"></ul>
    </div>

    <div class="examples">
      <div class="section-title">Try a prompt</div>
      <button class="example-chip" data-prompt="Find me remote Python developer jobs in AI startups, posted in the last 7 days">Remote Python jobs (AI startups)</button>
      <button class="example-chip" data-prompt="Collect SaaS leads in fintech from USA, top 30 companies">SaaS leads (fintech, USA)</button>
      <button class="example-chip" data-prompt="Get sponsorship opportunities for AI conferences, give me 15 results">AI sponsorship opportunities</button>
      <button class="example-chip" data-prompt="Find trending Rust open source repos with more than 1000 stars">Trending Rust repos</button>
      <button class="example-chip" data-prompt="Collect news about LLM and GenAI from this week">LLM/GenAI news this week</button>
      <button class="example-chip" data-prompt="Find me top 20 market data points for cybersecurity spend growth">Cybersecurity market data</button>
      <button class="example-chip" data-prompt="Mujhe remote Python developer ki naukri chahiye India me">🇮🇳 Hinglish: remote Python job India me</button>
      <button class="example-chip" data-prompt="Mujhe AI startup ke liye sponsorship chahiye">🇮🇳 Hinglish: AI sponsorship chahiye</button>
    </div>

    <div class="examples">
      <div class="section-title">Schedules</div>
      <button class="btn-secondary" id="btn-new-schedule" style="width:100%;margin-top:6px">＋ Schedule recurring run</button>
      <div id="schedule-list" class="item-list"></div>
    </div>

    <div class="examples">
      <div class="section-title">Webhooks</div>
      <button class="btn-secondary" id="btn-new-webhook" style="width:100%;margin-top:6px">＋ Add webhook</button>
      <div id="webhook-list" class="item-list"></div>
    </div>
  </aside>

  <section class="main-pane">
    <div class="empty-state" id="empty-state">
      <div class="empty-card">
        <div class="empty-emoji">🤖</div>
        <h2>Describe the data you need in plain English</h2>
        <p>The AI will design a collection workflow, fetch from permitted sources, validate & deduplicate, and present a clean dataset here.</p>
        <div class="empty-prompt-wrap">
          <textarea id="empty-prompt" placeholder="e.g. Find me remote Python developer jobs posted in the last 7 days"></textarea>
          <button class="voice-btn" id="btn-voice-empty" title="Voice prompt (Web Speech API)">🎤</button>
        </div>
        <div class="empty-actions">
          <button class="btn-primary" id="btn-empty-launch">Launch Workflow</button>
          <button class="btn-secondary" id="btn-empty-preview">Preview intent</button>
          <button class="btn-secondary" id="btn-empty-load-demo">⚡ Load Demo</button>
        </div>
        <div class="empty-preview" id="empty-preview" hidden></div>
      </div>
    </div>

    <div class="run-view" id="run-view" hidden>
      <div class="run-header">
        <div>
          <div class="run-id" id="run-id">run-</div>
          <div class="run-prompt" id="run-prompt"></div>
        </div>
        <div class="run-actions">
          <button class="btn-ghost" id="btn-export-json">Export JSON</button>
          <button class="btn-ghost" id="btn-export-csv">Export CSV</button>
          <button class="btn-ghost" id="btn-share">Share</button>
          <button class="btn-ghost" id="btn-replay">Replay</button>
          <button class="btn-ghost" id="btn-replay-diff" title="Replay & see what changed">↻ Replay & Diff</button>
          <button class="btn-ghost" id="btn-compare">Compare</button>
          <button class="btn-ghost" id="btn-quality">Data Quality</button>
          <button class="btn-danger" id="btn-delete">Delete</button>
        </div>
      </div>

      <div class="run-status-bar" id="run-status-bar">
        <div class="status-pill" id="status-pill">running…</div>
        <div class="status-text" id="status-text"></div>
      </div>

      <div class="summary-card" id="summary-card" hidden>
        <div class="section-title">AI-Generated Insights</div>
        <div class="summary-body" id="summary-body"></div>
        <div class="summary-insights" id="summary-insights"></div>
      </div>

      <div class="workflow-card">
        <div class="section-title">Workflow</div>
        <div class="steps" id="steps"></div>
      </div>

      <div class="intent-card" id="intent-card">
        <div class="section-title">Parsed intent</div>
        <div class="intent-grid" id="intent-grid"></div>
      </div>

      <div class="health-card" id="health-card" hidden>
        <div class="section-title">Source Health (this run)</div>
        <div class="health-grid" id="health-grid"></div>
      </div>

      <div class="summary-card" id="charts-card" hidden>
        <div class="section-title">Visual Analytics</div>
        <div class="charts-grid" id="charts-grid"></div>
      </div>

      <div class="results-card">
        <div class="results-toolbar">
          <input type="text" id="search-input" placeholder="Search records…" />
          <select id="source-filter"><option value="">All sources</option></select>
          <select id="score-filter">
            <option value="0">Any score</option>
            <option value="40">≥ 40</option>
            <option value="60">≥ 60</option>
            <option value="80">≥ 80</option>
          </select>
          <select id="sort-select">
            <option value="score_desc">Highest score</option>
            <option value="newest">Newest first</option>
            <option value="oldest">Oldest first</option>
            <option value="score_asc">Lowest score</option>
          </select>
        </div>
        <div class="results-meta" id="results-meta"></div>
        <div class="records" id="records"></div>
      </div>
    </div>
  </section>
</main>

<div class="modal" id="modal" hidden>
  <div class="modal-card">
    <div class="modal-header">
      <div class="modal-title">New data collection</div>
      <button class="modal-close" id="modal-close">×</button>
    </div>
    <div class="modal-body">
      <div class="modal-prompt-wrap">
        <textarea id="modal-prompt" placeholder="Describe the data you need..."></textarea>
        <button class="voice-btn" id="btn-voice-modal" title="Voice prompt (Web Speech API)">🎤</button>
      </div>
      <div class="modal-preview" id="modal-preview" hidden></div>
    </div>
    <div class="modal-footer">
      <button class="btn-secondary" id="btn-modal-preview">Preview intent</button>
      <button class="btn-primary" id="btn-modal-launch">Launch Workflow</button>
    </div>
  </div>
</div>

<div class="modal" id="schedule-modal" hidden>
  <div class="modal-card">
    <div class="modal-header">
      <div class="modal-title">Schedule recurring collection</div>
      <button class="modal-close" data-close="schedule-modal">×</button>
    </div>
    <div class="modal-body">
      <label style="font-size:12px;color:var(--text-mute);text-transform:uppercase;">Prompt</label>
      <textarea id="schedule-prompt" placeholder="e.g. Find me new AI jobs in last 24 hours" style="width:100%;min-height:80px;margin-top:6px;padding:10px;border-radius:8px;border:1px solid var(--border);background:var(--bg-2);color:var(--text);font-family:inherit;font-size:13px;"></textarea>
      <label style="font-size:12px;color:var(--text-mute);text-transform:uppercase;display:block;margin-top:14px;">Run every</label>
      <select id="schedule-interval" style="width:100%;margin-top:6px;padding:10px;border-radius:8px;border:1px solid var(--border);background:var(--bg-2);color:var(--text);font-family:inherit;font-size:13px;">
        <option value="900">15 minutes</option>
        <option value="1800">30 minutes</option>
        <option value="3600" selected>1 hour</option>
        <option value="21600">6 hours</option>
        <option value="86400">24 hours</option>
      </select>
    </div>
    <div class="modal-footer">
      <button class="btn-secondary" data-close="schedule-modal">Cancel</button>
      <button class="btn-primary" id="btn-schedule-save">Save Schedule</button>
    </div>
  </div>
</div>

<div class="modal" id="webhook-modal" hidden>
  <div class="modal-card">
    <div class="modal-header">
      <div class="modal-title">Add webhook notification</div>
      <button class="modal-close" data-close="webhook-modal">×</button>
    </div>
    <div class="modal-body">
      <label style="font-size:12px;color:var(--text-mute);text-transform:uppercase;">Webhook URL</label>
      <input id="webhook-url" placeholder="https://hooks.slack.com/services/..." style="width:100%;margin-top:6px;padding:10px;border-radius:8px;border:1px solid var(--border);background:var(--bg-2);color:var(--text);font-family:inherit;font-size:13px;" />
      <label style="font-size:12px;color:var(--text-mute);text-transform:uppercase;display:block;margin-top:14px;">Type</label>
      <select id="webhook-type" style="width:100%;margin-top:6px;padding:10px;border-radius:8px;border:1px solid var(--border);background:var(--bg-2);color:var(--text);font-family:inherit;font-size:13px;">
        <option value="slack">Slack</option>
        <option value="discord">Discord</option>
        <option value="generic">Generic JSON</option>
      </select>
      <label style="font-size:12px;color:var(--text-mute);text-transform:uppercase;display:block;margin-top:14px;">Trigger on</label>
      <select id="webhook-event" style="width:100%;margin-top:6px;padding:10px;border-radius:8px;border:1px solid var(--border);background:var(--bg-2);color:var(--text);font-family:inherit;font-size:13px;">
        <option value="run_done">Run completes</option>
        <option value="run_failed">Run fails</option>
      </select>
    </div>
    <div class="modal-footer">
      <button class="btn-secondary" data-close="webhook-modal">Cancel</button>
      <button class="btn-primary" id="btn-webhook-save">Save Webhook</button>
    </div>
  </div>
</div>

<div class="modal" id="compare-modal" hidden>
  <div class="modal-card wide">
    <div class="modal-header">
      <div class="modal-title">Compare runs</div>
      <button class="modal-close" data-close="compare-modal">×</button>
    </div>
    <div class="modal-body" id="compare-body">
      <p style="color:var(--text-mute);">Pick a second run to compare:</p>
      <select id="compare-b" style="width:100%;padding:10px;border-radius:8px;border:1px solid var(--border);background:var(--bg-2);color:var(--text);"></select>
      <div id="compare-result" style="margin-top:14px;"></div>
    </div>
    <div class="modal-footer">
      <button class="btn-secondary" data-close="compare-modal">Close</button>
    </div>
  </div>
</div>

<div class="modal" id="ab-modal" hidden>
  <div class="modal-card">
    <div class="modal-header">
      <div class="modal-title">🆎 A/B Prompt Test</div>
      <button class="modal-close" data-close="ab-modal">×</button>
    </div>
    <div class="modal-body">
      <p style="color:var(--text-soft);font-size:13px;margin:0 0 10px;">Run 2-4 prompt variants in parallel and compare results.</p>
      <label style="font-size:12px;color:var(--text-mute);text-transform:uppercase;">Variant 1</label>
      <textarea id="ab-prompt-1" placeholder="e.g. Find me Python developer jobs" style="width:100%;min-height:60px;margin:6px 0 10px;padding:10px;border-radius:8px;border:1px solid var(--border);background:var(--bg-2);color:var(--text);font-family:inherit;font-size:13px;"></textarea>
      <label style="font-size:12px;color:var(--text-mute);text-transform:uppercase;">Variant 2</label>
      <textarea id="ab-prompt-2" placeholder="e.g. Show me remote Python engineer positions" style="width:100%;min-height:60px;margin:6px 0 10px;padding:10px;border-radius:8px;border:1px solid var(--border);background:var(--bg-2);color:var(--text);font-family:inherit;font-size:13px;"></textarea>
      <button class="btn-secondary" id="btn-ab-add" style="font-size:11px;">+ Add variant</button>
      <div id="ab-extras"></div>
    </div>
    <div class="modal-footer">
      <button class="btn-secondary" data-close="ab-modal">Cancel</button>
      <button class="btn-primary" id="btn-ab-launch">Launch A/B Test</button>
    </div>
  </div>
</div>

<div class="modal" id="source-modal" hidden>
  <div class="modal-card wide">
    <div class="modal-header">
      <div class="modal-title">🔍 Source: <span id="source-modal-name">--</span></div>
      <button class="modal-close" data-close="source-modal">×</button>
    </div>
    <div class="modal-body">
      <div id="source-modal-meta" style="margin-bottom:14px;"></div>
      <div class="records" id="source-modal-records"></div>
    </div>
    <div class="modal-footer">
      <button class="btn-secondary" data-close="source-modal">Close</button>
    </div>
  </div>
</div>

<div class="modal" id="quality-modal" hidden>
  <div class="modal-card wide">
    <div class="modal-header">
      <div class="modal-title">✅ Data Quality Report</div>
      <button class="modal-close" data-close="quality-modal">×</button>
    </div>
    <div class="modal-body" id="quality-modal-body"></div>
    <div class="modal-footer">
      <button class="btn-secondary" data-close="quality-modal">Close</button>
    </div>
  </div>
</div>

<div class="modal" id="diff-modal" hidden>
  <div class="modal-card wide">
    <div class="modal-header">
      <div class="modal-title">🔄 Replay Diff</div>
      <button class="modal-close" data-close="diff-modal">×</button>
    </div>
    <div class="modal-body" id="diff-modal-body">
      <div class="no-records">Pick another run to diff against.</div>
      <select id="diff-target" style="width:100%;margin-top:10px;padding:10px;border-radius:8px;border:1px solid var(--border);background:var(--bg-2);color:var(--text);"></select>
      <div id="diff-result" style="margin-top:14px;"></div>
    </div>
    <div class="modal-footer">
      <button class="btn-secondary" id="btn-replay-diff-go">↻ Replay & Show Diff</button>
      <button class="btn-secondary" data-close="diff-modal">Close</button>
    </div>
  </div>
</div>

<div class="modal" id="notif-modal" hidden>
  <div class="modal-card">
    <div class="modal-header">
      <div class="modal-title">🔔 Notifications</div>
      <button class="modal-close" data-close="notif-modal">×</button>
    </div>
    <div class="modal-body" id="notif-body">
      <div class="no-records">No notifications yet</div>
    </div>
    <div class="modal-footer">
      <button class="btn-secondary" id="btn-notif-clear">Clear all</button>
      <button class="btn-secondary" data-close="notif-modal">Close</button>
    </div>
  </div>
</div>

<div class="modal" id="watchlist-modal" hidden>
  <div class="modal-card wide">
    <div class="modal-header">
      <div class="modal-title">★ Watchlist (starred records)</div>
      <button class="modal-close" data-close="watchlist-modal">×</button>
    </div>
    <div class="modal-body">
      <div class="records" id="watchlist-records"></div>
    </div>
    <div class="modal-footer">
      <button class="btn-secondary" data-close="watchlist-modal">Close</button>
    </div>
  </div>
</div>

<div class="modal" id="analytics-modal" hidden>
  <div class="modal-card wide">
    <div class="modal-header">
      <div class="modal-title">📊 Platform Analytics</div>
      <button class="modal-close" data-close="analytics-modal">×</button>
    </div>
    <div class="modal-body" id="analytics-body"></div>
    <div class="modal-footer">
      <button class="btn-secondary" data-close="analytics-modal">Close</button>
    </div>
  </div>
</div>

<div class="toast-host" id="toast-host"></div>

<div id="kbd-hint" style="position:fixed;bottom:14px;left:14px;font-size:11px;color:var(--text-mute);background:var(--panel);border:1px solid var(--border-soft);padding:6px 10px;border-radius:8px;z-index:60;">
  <kbd>N</kbd> New · <kbd>D</kbd> Demo · <kbd>T</kbd> Theme · <kbd>/</kbd> Search · <kbd>B</kbd> A/B · <kbd>Esc</kbd>
</div>

<script src="/static/js/app.js"></script>
</body>
</html>