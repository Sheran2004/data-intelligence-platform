# Production environment variables (copy to .env to override)

# Server port (set automatically by Heroku/Render/etc.)
PORT=5000

# Path to the SQLite database (set to a persistent volume in production)
DIP_DB_PATH=data/platform.db

# Optional: comma-separated list of allowed CORS origins
# DIP_CORS_ORIGINS=*

# Optional: log level
# LOG_LEVEL=info

# Optional: disable live scheduler (only for testing)
# DIP_DISABLE_SCHEDULER=0